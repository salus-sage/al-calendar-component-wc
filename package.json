{
  "name": "al-date-picker",
  "version": "0.1.18",
  "description": "Native Web Components for date and datetime selection across Angular, Lit, and React",
  "files": [
    "dist",
    "angular",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/albert-date-picker.js",
  "module": "dist/albert-date-picker.js",
  "exports": {
    ".": {
      "import": "./dist/albert-date-picker.js"
    },
    "./angular": {
      "import": "./angular/index.js",
      "default": "./angular/index.js",
      "types": "./angular/index.d.ts"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build",
    "serve": "esbuild --servedir=. --serve=3000",
    "test": "npm run build && playwright test",
    "test:watch": "playwright test --ui"
  },
  "devDependencies": {
    "@angular/common": "^10.2.5",
    "@angular/core": "^10.2.5",
    "@angular/forms": "^10.2.5",
    "@playwright/test": "1.36.0",
    "@types/node": "^16.0.0",
    "esbuild": "0.17.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@angular/core": "^10 || ^15",
    "@angular/forms": "^10 || ^15"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    }
  }
}
